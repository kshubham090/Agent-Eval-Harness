# Supply an exact, reviewed npm package version when building this image.
# Example: --build-arg AGENT_PACKAGE=@openai/codex@0.160.0
FROM node:22-bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 git ca-certificates \
    && ln -s /usr/bin/python3 /usr/local/bin/python \
    && rm -rf /var/lib/apt/lists/*
ARG AGENT_PACKAGE
RUN test -n "$AGENT_PACKAGE" \
    && npm install --global "$AGENT_PACKAGE" \
    && npm cache clean --force
USER 65534:65534
WORKDIR /workspace
